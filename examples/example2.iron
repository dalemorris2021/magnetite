local io = import "std.io"
local sys = import "std.sys"

-- This is a single-line comment

--[[
    This is a
    multi-line comment
]]

--[=[
    This is a nested multi-line comment
    that can safely contain [[double brackets]].

    However many equal signs are used at the beginning of the block
    must also be used at the end of the block.
]=]

--[[
    The main function only exists by convention.

    It can be a useful way to conditionally run code in a source file.
]]
local main = fun argc args start
    io.printf "{}\n" ["Hello, world!"]

    () -- Parenthese denote the unit type which is essentially a void value
end

--[[
    This will only run if this source file was invoked by the interpeter.

    It will not run if the code in this file is loaded by another file.
]]
if __FILE__ == $0 then
    main sys.argc sys.argv
end
